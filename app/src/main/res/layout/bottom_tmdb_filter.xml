<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/black">

    <!-- Fixed Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with title and default/reset buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TMDB Filter"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/load_default_button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Load Defaults"
                    android:textSize="11sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    style="@style/BlackButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/set_default_button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Set Default"
                    android:textSize="11sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    style="@style/BlackButton" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

    
    <!-- Format Selector (Movie/TV) - REQUIRED for TMDB -->
    <LinearLayout
        android:id="@+id/tmdb_format_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Format"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_format_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movie"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_format_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdb_format_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="150dp"
        android:visibility="gone" />

    <!-- Genres Section -->
    <LinearLayout
        android:id="@+id/tmdb_genres_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genres"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_genres_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_genres_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdb_genres_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="300dp"
        android:visibility="gone"
         />

    <!-- Keyword Section -->
    <LinearLayout
        android:id="@+id/tmdb_keyword_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keywords"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_keyword_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="None"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_keyword_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tmdb_keyword_input_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tmdb_keyword_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter keywords (e.g., marvel, action, comedy)"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Year Section -->
    <LinearLayout
        android:id="@+id/tmdb_year_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Year"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_year_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_year_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdb_year_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="300dp"
        android:visibility="gone"
         />

    <!-- Country Section -->
    <LinearLayout
        android:id="@+id/tmdb_country_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Country"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_country_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_country_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdb_country_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="300dp"
        android:visibility="gone"
         />

    <!-- Trending Section -->
    <LinearLayout
        android:id="@+id/tmdb_trending_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trending"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_trending_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Off"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_trending_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdb_trending_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="150dp"
        android:visibility="gone"
         />

    <!-- Provider (Streaming On) Section -->
    <LinearLayout
        android:id="@+id/tmdb_provider_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streaming On"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_provider_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_provider_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdb_provider_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="300dp"
        android:visibility="gone"
         />

    <!-- Minimum Votes Section -->
    <LinearLayout
        android:id="@+id/tmdb_min_votes_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minimum Votes"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_min_votes_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_min_votes_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdb_min_votes_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="200dp"
        android:visibility="gone"
         />

    <!-- Sort Section -->
    <LinearLayout
        android:id="@+id/tmdb_sort_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

            <TextView
                android:id="@+id/tmdb_sort_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Popularity"
                android:textSize="12sp"
                android:textColor="?attr/grayTextColor" />

        </LinearLayout>

        <ImageView
            android:id="@+id/tmdb_sort_expand_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_baseline_arrow_forward_24"
            android:tint="?attr/textColor"
            android:contentDescription="Expand" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdb_sort_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="300dp"
        android:visibility="gone"
         />

    <!-- Adult Content Toggle -->
    <LinearLayout
        android:id="@+id/tmdb_adult_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@android:color/black">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Include Adult Content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textColor" />

        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/tmdb_adult_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    </LinearLayout>

    </ScrollView>

    <!-- Fixed Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="16dp"
        android:background="@android:color/black">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tmdb_clear_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Clear"
            style="@style/BlackButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tmdb_apply_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            style="@style/WhiteButton" />

    </LinearLayout>

</LinearLayout>
