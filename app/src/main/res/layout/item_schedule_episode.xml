<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="?attr/primaryGrayBackground"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/episode_poster"
            android:layout_width="48dp"
            android:layout_height="68dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/episode_poster_img_des"
            app:srcCompat="@drawable/example_poster" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/episode_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Jujutsu Kaisen" />

            <TextView
                android:id="@+id/episode_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                tools:text="Episode 14" />

            <TextView
                android:id="@+id/episode_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/outline_drawable"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textAllCaps="true"
                tools:text="ANIME" />

        </LinearLayout>

        <TextView
            android:id="@+id/episode_day_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/darker_gray"
            android:textSize="13sp"
            android:gravity="end"
            tools:text="Today" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
