<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/profile"
                android:textColor="?attr/textColor"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Profile header: centered avatar + accent edit badge + name -->
            <LinearLayout
                android:id="@+id/settings_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="44dp">

                        <ImageView
                            android:id="@+id/settings_profile_pic"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/account"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/profile_bg_orange" />
                    </androidx.cardview.widget.CardView>

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_settings_edit_badge">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/account"
                            android:src="@drawable/ic_settings_edit_pencil"
                            android:tint="?attr/white" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/settings_profile_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="?attr/textColor"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Quick Brown Fox" />
            </LinearLayout>

            <!-- Settings rows -->
            <LinearLayout
                android:id="@+id/settings_general"
                style="@style/SettingsRow"
                android:nextFocusDown="@id/settings_player">

                <FrameLayout style="@style/SettingsRowIconBg">
                    <ImageView style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_row_general" />
                </FrameLayout>

                <TextView style="@style/SettingsRowLabel"
                    android:text="@string/category_general" />

                <ImageView style="@style/SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:id="@+id/settings_player"
                style="@style/SettingsRow"
                android:nextFocusUp="@id/settings_general"
                android:nextFocusDown="@id/settings_providers">

                <FrameLayout style="@style/SettingsRowIconBg">
                    <ImageView style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_row_player" />
                </FrameLayout>

                <TextView style="@style/SettingsRowLabel"
                    android:text="@string/category_player" />

                <ImageView style="@style/SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:id="@+id/settings_providers"
                style="@style/SettingsRow"
                android:nextFocusUp="@id/settings_player"
                android:nextFocusDown="@id/settings_ui">

                <FrameLayout style="@style/SettingsRowIconBg">
                    <ImageView style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_row_providers" />
                </FrameLayout>

                <TextView style="@style/SettingsRowLabel"
                    android:text="@string/category_providers" />

                <ImageView style="@style/SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:id="@+id/settings_ui"
                style="@style/SettingsRow"
                android:nextFocusUp="@id/settings_providers"
                android:nextFocusDown="@id/settings_updates">

                <FrameLayout style="@style/SettingsRowIconBg">
                    <ImageView style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_row_ui" />
                </FrameLayout>

                <TextView style="@style/SettingsRowLabel"
                    android:text="@string/category_ui" />

                <ImageView style="@style/SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:id="@+id/settings_updates"
                style="@style/SettingsRow"
                android:nextFocusUp="@id/settings_ui"
                android:nextFocusDown="@id/settings_credits">

                <FrameLayout style="@style/SettingsRowIconBg">
                    <ImageView style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_row_updates" />
                </FrameLayout>

                <TextView style="@style/SettingsRowLabel"
                    android:text="@string/category_updates" />

                <ImageView style="@style/SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:id="@+id/settings_credits"
                style="@style/SettingsRow"
                android:nextFocusUp="@id/settings_updates"
                android:nextFocusDown="@id/settings_extensions">

                <FrameLayout style="@style/SettingsRowIconBg">
                    <ImageView style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_row_account" />
                </FrameLayout>

                <TextView style="@style/SettingsRowLabel"
                    android:text="@string/category_account" />

                <ImageView style="@style/SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:id="@+id/settings_extensions"
                style="@style/SettingsRow"
                android:nextFocusUp="@id/settings_credits"
                android:nextFocusDown="@id/settings_downloads">

                <FrameLayout style="@style/SettingsRowIconBg">
                    <ImageView style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_row_extensions" />
                </FrameLayout>

                <TextView style="@style/SettingsRowLabel"
                    android:text="@string/extensions" />

                <ImageView style="@style/SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:id="@+id/settings_downloads"
                style="@style/SettingsRow"
                android:nextFocusUp="@id/settings_extensions">

                <FrameLayout style="@style/SettingsRowIconBg">
                    <ImageView style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_settings_row_downloads" />
                </FrameLayout>

                <TextView style="@style/SettingsRowLabel"
                    android:text="@string/title_downloads" />

                <ImageView style="@style/SettingsRowChevron" />
            </LinearLayout>

            <View style="@style/SettingsRowDivider" />

            <LinearLayout
                android:id="@+id/app_version_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="12sp"
                    tools:text="0.0.0" />

                <TextView
                    android:id="@+id/delimiter0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/commit_hash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="12sp"
                    tools:text="1234567" />

                <TextView
                    android:id="@+id/delimiter1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="•"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/build_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:textColor="?attr/grayTextColor"
                    android:textSize="12sp"
                    tools:text="21/03/2024 09:02 pm" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>