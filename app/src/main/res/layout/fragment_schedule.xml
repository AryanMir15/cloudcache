<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryBlackBackground">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/schedule_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/primaryBlackBackground"
                android:paddingTop="@dimen/navbar_height"
                app:layout_scrollFlags="scroll|enterAlways"
                app:navigationIconTint="?attr/iconColor"
                app:title="Schedule"
                app:titleTextColor="?attr/textColor" />

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- Day selector: centered, non-scrollable -->
            <LinearLayout
                android:id="@+id/day_selector_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/day_mon"
                    style="@style/ScheduleDayPill"
                    android:text="M" />

                <TextView
                    android:id="@+id/day_tue"
                    style="@style/ScheduleDayPill"
                    android:text="T" />

                <TextView
                    android:id="@+id/day_wed"
                    style="@style/ScheduleDayPill"
                    android:text="W" />

                <TextView
                    android:id="@+id/day_thu"
                    style="@style/ScheduleDayPill"
                    android:text="T" />

                <TextView
                    android:id="@+id/day_fri"
                    style="@style/ScheduleDayPill"
                    android:text="F" />

                <TextView
                    android:id="@+id/day_sat"
                    style="@style/ScheduleDayPill"
                    android:text="S" />

                <TextView
                    android:id="@+id/day_sun"
                    style="@style/ScheduleDayPill"
                    android:text="S" />

            </LinearLayout>

            <!-- Separator line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/schedule_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="48dp"
                android:visibility="gone" />

            <!-- Error text -->
            <TextView
                android:id="@+id/schedule_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="48dp"
                android:textColor="@android:color/darker_gray"
                android:textSize="16sp"
                android:visibility="gone"
                tools:text="Could not load schedule" />

            <!-- Empty text -->
            <TextView
                android:id="@+id/schedule_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="48dp"
                android:text="@string/no_episodes_scheduled"
                android:textColor="@android:color/darker_gray"
                android:textSize="16sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Schedule cards list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/schedule_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="4dp"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_schedule_card" />

            <!-- Status bar (loading / TMDB key missing) -->
            <TextView
                android:id="@+id/schedule_status_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1AFFFFFF"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="#99FFFFFF"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Fetching high quality banners from TMDB..."
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</FrameLayout>
