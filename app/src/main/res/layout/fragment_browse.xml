<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/browse_root"
    style="@style/DarkFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/navbar_height"
    android:background="?attr/primaryGrayBackground">

    <!-- Results Grid -->
    <com.lagradost.cloudstream3.ui.AutofitRecyclerView
        android:id="@+id/browse_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/primaryBlackBackground"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="70dp"
        tools:listitem="@layout/search_result_grid" />

    <!-- Loading Bar -->
    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/browse_loading_bar"
        style="@style/Widget.AppCompat.ProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:foregroundTint="@color/white"
        android:progressTint="@color/white"
        android:visibility="gone" />

    <!-- Floating Top Bar Container (Search, Chips, Filter Labels) -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/primaryGrayBackground"
        android:elevation="4dp">

            <!-- Search Bar with Filter Icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_scrollFlags="scroll|enterAlways">

            <ImageView
                android:id="@+id/voice_search"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginStart="10dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/change_providers_img_des"
                android:src="@drawable/ic_mic"
                app:tint="?attr/textColor" />

            <!-- Metadata Language Dropdown - Separate from filters -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="10dp"
                android:background="@drawable/search_background">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="30dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:gravity="center"
                    android:text="en-US"
                    android:textColor="?attr/textColor"
                    android:textSize="12sp"
                    android:drawableEnd="@drawable/ic_baseline_keyboard_arrow_down_24"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:id="@+id/metadata_language_text" />

                <ImageView
                    android:id="@+id/metadata_language_dropdown"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Change metadata language"
                    android:src="@drawable/ic_baseline_language_24"
                    app:tint="?attr/textColor" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_margin="10dp"
                android:background="@drawable/search_background"
                android:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="60dp">

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/browse_search"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:iconifiedByDefault="false"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:queryHint="Search in AniList"
                        app:iconifiedByDefault="false"
                        app:queryBackground="@color/transparent"
                        app:searchHintIcon="@null"
                        app:searchIcon="@null" />

                    <androidx.core.widget.ContentLoadingProgressBar
                        android:id="@+id/browse_search_loading_bar"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="-35dp"
                        android:indeterminateTint="@color/white" />

                </FrameLayout>

                <!-- Filter Icon inside search bar -->
                <ImageView
                    android:id="@+id/filter_button"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="10dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="Filter"
                    android:src="@drawable/ic_baseline_filter_list_24"
                    app:tint="?attr/textColor" />

                <!-- Swap Provider Button on right side of search bar -->
                <ImageView
                    android:id="@+id/swap_metadata_button"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="40dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:contentDescription="Swap Metadata"
                    android:src="@drawable/ic_baseline_swap_horiz_24"
                    app:tint="?attr/textColor" />
            </FrameLayout>
        </LinearLayout>

            <!-- Genre and Tags Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Genre Chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/genre_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- Tags Chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tags_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

            <!-- Filter Labels (Year, Season, Format, Sort) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/year_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#4D000000"
                    android:minWidth="65dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Year: All"
                    android:textColor="?attr/textColor"
                    android:textSize="12sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/secondary_filter_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#4D000000"
                    android:minWidth="65dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Season: All"
                    android:textColor="?attr/textColor"
                    android:textSize="12sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/format_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#4D000000"
                    android:minWidth="65dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Format: All"
                    android:textColor="?attr/textColor"
                    android:textSize="12sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:id="@+id/sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#4D000000"
                    android:minWidth="65dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="Sort: Popularity"
                    android:textColor="?attr/textColor"
                    android:textSize="12sp"
                    app:autoSizeMaxTextSize="14sp"
                    app:autoSizeMinTextSize="6sp"
                    app:autoSizeTextType="uniform" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/streaming_provider_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="All"
                    android:textColor="@android:color/white"
                    android:visibility="gone"
                    app:chipBackgroundColor="#E50914"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeWidth="0dp" />
            </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

    <!-- No Results Text (overlay) -->
    <TextView
        android:id="@+id/no_results_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No results found"
        android:textColor="?attr/textColor"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- No More Results Toast - Bottom (default) -->
    <TextView
        android:id="@+id/end_of_results_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:background="#CC000000"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="No more results"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- No More Results Toast - Top (when keyboard is visible) -->
    <TextView
        android:id="@+id/end_of_results_toast_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="120dp"
        android:background="#CC000000"
        android:elevation="8dp"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="No more results"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
